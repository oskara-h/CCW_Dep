######################################
### EXTRACT CLUSTER-ROBUST RESULTS ###
######################################

extract_polr_clustered_results <- function(model, data, cluster_variable = "municipality") {
  
  model_rows <- as.integer(rownames(stats::model.frame(model)))
  cluster_id <- as.factor(data[[cluster_variable]][model_rows])
  
  clustered_vcov <- sandwich::vcovCL(
    x = model,
    cluster = cluster_id,
    type = "HC1"
  )
  
  slope_terms <- names(stats::coef(model))
  
  estimates <- stats::coef(model)[slope_terms]
  variances <- diag(clustered_vcov)[slope_terms]
  std_errors <- sqrt(variances)
  statistics <- estimates / std_errors
  p_values <- 2 * stats::pnorm(abs(statistics), lower.tail = FALSE)
  
  tibble::tibble(
    term = slope_terms,
    estimate = unname(estimates),
    std.error = unname(std_errors),
    statistic = unname(statistics),
    p.value = unname(p_values),
    conf.low = estimate - 1.96 * std.error,
    conf.high = estimate + 1.96 * std.error,
    odds_ratio = exp(estimate),
    or_lower_ci = exp(conf.low),
    or_upper_ci = exp(conf.high)
  )
}

extract_glm_clustered_results <- function(model, data, cluster_variable = "municipality") {
  
  model_rows <- as.integer(rownames(stats::model.frame(model)))
  cluster_id <- as.factor(data[[cluster_variable]][model_rows])
  
  clustered_vcov <- sandwich::vcovCL(
    x = model,
    cluster = cluster_id,
    type = "HC1"
  )
  
  model_terms <- names(stats::coef(model))
  
  estimates <- stats::coef(model)[model_terms]
  variances <- diag(clustered_vcov)[model_terms]
  std_errors <- sqrt(variances)
  statistics <- estimates / std_errors
  p_values <- 2 * stats::pnorm(abs(statistics), lower.tail = FALSE)
  
  tibble::tibble(
    term = model_terms,
    estimate = unname(estimates),
    std.error = unname(std_errors),
    statistic = unname(statistics),
    p.value = unname(p_values),
    conf.low = estimate - 1.96 * std.error,
    conf.high = estimate + 1.96 * std.error,
    odds_ratio = exp(estimate),
    or_lower_ci = exp(conf.low),
    or_upper_ci = exp(conf.high)
  ) %>%
    filter(term != "(Intercept)")
}

ordinal_results_cc_or <- extract_polr_clustered_results(
  model = ordinal_model_cc,
  data = complete_case_ordinal
)

binary_results_cc_or <- extract_glm_clustered_results(

#######################

common_predictors <- c(
  "depression_centered",
  "antisocial_centered",
  "gender_binary",
  "age",
  "ses",
  "university_plans_binary",
  "cannabis_binary",
  "family_conflict_0",
  "school_dissatisfaction_mean_0",
  "bullying_mean_0",
  "no_close_peer_relationship_binary",
  "club_membership_binary",
  "social_media_time_0",
  "social_media_pressure_0",
  "reading_time_0",
  "urbanicity_0",
  "family_violence_binary",
  "municipality"
)

ordinal_model_variables <- c(
  "climate_ordinal",
  common_predictors
)

binary_model_variables <- c(
  "climate_binary",
  common_predictors
)

###################
### CC DATASETS ###
###################
complete_case_ordinal <- depressed_sample %>%
  dplyr::select(all_of(ordinal_model_variables)) %>%
  filter(!is.na(climate_ordinal)) %>%
  tidyr::drop_na() %>%
  mutate(
    climate_ordinal = factor(
      climate_ordinal,
      levels = c(0, 1, 2),
      labels = c("A little worried", "Quite worried", "Very worried"),
      ordered = TRUE
    ),
    municipality = factor(municipality)
  )

complete_case_binary <- depressed_sample %>%
  dplyr::select(all_of(binary_model_variables)) %>%
  filter(!is.na(climate_binary)) %>%
  tidyr::drop_na() %>%
  mutate(
    no_climate_worry = 1 - climate_binary,
    municipality = factor(municipality)
  )

######################
### MODEL FORMULAS ###
######################

ordinal_formula_cc <- climate_ordinal ~
  depression_centered *
  antisocial_centered +
  gender_binary +
  age +
  ses +
  university_plans_binary +
  cannabis_binary +
  family_conflict_0 +
  school_dissatisfaction_mean_0 +
  bullying_mean_0 +
  no_close_peer_relationship_binary +
  club_membership_binary +
  social_media_time_0 +
  social_media_pressure_0 +
  reading_time_0 +
  urbanicity_0 +
  family_violence_binary

binary_formula_cc <- no_climate_worry ~
  depression_centered +
  antisocial_centered +
  gender_binary +
  age +
  ses +
  university_plans_binary +
  cannabis_binary +
  family_conflict_0 +
  school_dissatisfaction_mean_0 +
  bullying_mean_0 +
  no_close_peer_relationship_binary +
  club_membership_binary +
  social_media_time_0 +
  social_media_pressure_0 +
  reading_time_0 +
  urbanicity_0 +
  family_violence_binary

#####################
### FIT CC MODELS ###
#####################

ordinal_model_cc <- MASS::polr(
  formula = ordinal_formula_cc,
  data = complete_case_ordinal,
  Hess = TRUE,
  model = TRUE
)

binary_model_cc <- glm(
  formula = binary_formula_cc,
  data = complete_case_binary,
  family = binomial(link = "logit")
)


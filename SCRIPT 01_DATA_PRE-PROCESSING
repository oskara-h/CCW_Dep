    # University plans:
     # Yes = 1
     # No / don't know = 0
     university_plans_binary = case_when(
      university_plans == 1 ~ 1,
      university_plans %in% c(2,3) ~ 0,
      TRUE ~ NA_real_
    ),

    # No close friend:
     # Definitely no / no I don't think so = 1
     # Otherwise = 0
     no_close_peer_relationship_binary = case_when(
     peer_relationship %in% c(1,2) ~ 0,
     peer_relationship %in% c(3,4) ~ 1,
     TRUE ~ NA_real_
    ),
        
    # Club membership:
     # Current member = 1
     # Previous / never = 0
     club_membership_binary = case_when(
      club_membership == 1 ~ 1,
      club_membership %in% c(2,3) ~ 0,
      TRUE ~ NA_real_
    ),
    # Family violence exposure:
     # 0 = no reported family violence exposure
     # 1 = reported physical violence and/or witnessing violence in the family

    family_violence_binary = case_when(
      violence8 > 1 | violence9 > 1 ~ 1,
      violence8 == 1 & violence9 == 1 ~ 0,
      TRUE ~ NA_real_
    ),
   # Family conflict:
   # Original item: "There is often conflict between the adults in my family"
    # 1 = fits very well, 4 = fits very poorly
    # Recode so that higher values indicate greater family conflict
   family_conflict_0 = case_when(
     family_conflict == 1 ~ 3,
     family_conflict == 2 ~ 2,
     family_conflict == 3 ~ 1,
     family_conflict == 4 ~ 0,
     TRUE ~ NA_real_
    ),
   
   # Binary cannabis use variable:
    # 0 = no cannabis use in the past year
    # 1 = any cannabis use in the past year
    cannabis_binary = case_when(
      cannabis_use == 1 ~ 0,
      cannabis_use %in% c(2, 3, 4, 5) ~ 1,
      TRUE ~ NA_real_
    )
  )


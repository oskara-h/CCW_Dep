#############################################################
### COMPLETE-CASE BRANT TEST: FOUR-CATEGORY CLIMATE WORRY ###
#############################################################
# Diagnostic check of the proportional odds assumption when climate worry is treated as one ordinal outcome with all four substantive categories: 0 = not worried, 1 = a little worried, 2 = quite worried, 3 = very worried

# Define variables used in the four-category diagnostic model
fourcat_brant_variables <- c(
  "climate_worry_0",
  "depression_centered",
  "antisocial_centered",
  "gender_binary",
  "age",
  "ses",
  "university_plans_binary",
  "cannabis_binary",
  "family_conflict_0",
  "school_dissatisfaction_mean_0",
  "bullying_mean_0",
  "no_close_peer_relationship_binary",
  "club_membership_binary",
  "social_media_time_0",
  "social_media_pressure_0",
  "reading_time_0",
  "urbanicity_0",
  "family_violence_binary"
)

# Create complete-case dataset
complete_case_4cat <- depressed_sample %>%
  dplyr::select(all_of(fourcat_brant_variables)) %>%
  tidyr::drop_na() %>%
  mutate(
    climate_worry_4cat = factor(
      climate_worry_0,
      levels = c(0, 1, 2, 3),
      labels = c(
        "Not worried",
        "A little worried",
        "Quite worried",
        "Very worried"
      ),
      ordered = TRUE
    )
  )

# Check distribution
table(
  complete_case_4cat$climate_worry_4cat,
  useNA = "ifany"
)

# Fit four-category ordinal logistic model
fourcat_ordinal_model_cc <- MASS::polr(
  climate_worry_4cat ~
    depression_centered *
    antisocial_centered +
    gender_binary +
    age +
    ses +
    university_plans_binary +
    cannabis_binary +
    family_conflict_0 +
    school_dissatisfaction_mean_0 +
    bullying_mean_0 +
    no_close_peer_relationship_binary +
    club_membership_binary +
    social_media_time_0 +
    social_media_pressure_0 +
    reading_time_0 +
    urbanicity_0 +
    family_violence_binary,
  data = complete_case_4cat,
  Hess = TRUE,
  model = TRUE
)

# Run Brant test
brant_4cat_complete_case <- brant::brant(
  fourcat_ordinal_model_cc
)


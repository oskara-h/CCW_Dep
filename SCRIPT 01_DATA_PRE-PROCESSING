###############################
### CLIMATE WORRY VARIABLES ###
###############################

depressed_sample <- depressed_sample %>%
  mutate(
    # Set "don't know" to missing
    climate_worry = ifelse(
      climate_worry == 5,
      NA_real_,
      climate_worry
    ),
    
    # 0-based version of the original climate worry variable
    # 0 = not worried
    # 1 = a little worried
    # 2 = quite worried
    # 3 = very worried
    climate_worry_0 = case_when(
      climate_worry == 1 ~ 0,
      climate_worry == 2 ~ 1,
      climate_worry == 3 ~ 2,
      climate_worry == 4 ~ 3,
      TRUE ~ NA_real_
    ),
    
    # Binary outcome:
    # 0 = no worry
    # 1 = any worry
    ## For the binary regression analyses, this variable is subsequently reverse-coded so that the modeled outcome is:
     # 1 = no climate worry
     # 0 = any climate worry
     # This corresponds to the outcome coding reported in the manuscript.
    climate_binary = case_when(
      climate_worry == 1 ~ 0,
      climate_worry %in% c(2, 3, 4) ~ 1,
      TRUE ~ NA_real_
    ),
    
    # Ordinal outcome among worried only:
    # 0 = a little worried
    # 1 = quite worried
    # 2 = very worried
    climate_ordinal = case_when(
      climate_worry == 2 ~ 0,
      climate_worry == 3 ~ 1,
      climate_worry == 4 ~ 2,
      TRUE ~ NA_real_
    )
  )


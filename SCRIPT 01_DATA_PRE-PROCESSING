################################################
### MUNICIPALITY CLUSTERING: NULL ICC MODELS ###
################################################
# Prepare complete-case data for the binary outcome
icc_binary_data <- depressed_sample %>%
  filter(
    !is.na(climate_binary),
    !is.na(municipality)
  ) %>%
  mutate(
    climate_disengagement = 1 - climate_binary,
    municipality = factor(municipality)
  )

# Prepare complete-case data for the ordinal outcome
icc_ordinal_data <- depressed_sample %>%
  filter(
    !is.na(climate_ordinal),
    !is.na(municipality)
  ) %>%
  mutate(
    climate_ordinal = factor(
      climate_ordinal,
      ordered = TRUE
    ),
    municipality = factor(municipality)
  )

# Binary null model:
# outcome = climate disengagement
# 1 = no climate worry
# 0 = any climate worry
icc_binary_model <- lme4::glmer(
  climate_disengagement ~ 1 + (1 | municipality),
  data = icc_binary_data,
  family = binomial(link = "logit"),
  control = glmerControl(
    optimizer = "bobyqa",
    optCtrl = list(maxfun = 100000)
  )
)

# Ordinal null model:
# outcome = climate worry severity among worried adolescents
# 0 = a little worried
# 1 = quite worried
# 2 = very worried
icc_ordinal_model <- ordinal::clmm(
  climate_ordinal ~ 1 + (1 | municipality),
  data = icc_ordinal_data,
  link = "logit",
  Hess = TRUE
)

# Extract municipality-level variance components
binary_municipality_variance <- as.data.frame(
  lme4::VarCorr(icc_binary_model)
)$vcov[1]

ordinal_municipality_variance <- as.numeric(
  ordinal::VarCorr(icc_ordinal_model)$municipality
)

# Compute ICCs using the latent-variable logistic residual variance
# pi^2 / 3 is used for logistic mixed models.
icc_summary <- tibble::tibble(
  outcome = c(
    "Climate disengagement",
    "Climate worry severity among worried adolescents"
  ),
  model = c(
    "Binary logistic null model",
    "Ordinal logistic null model"
  ),
  n_observations = c(
    nrow(icc_binary_data),
    nrow(icc_ordinal_data)
  ),
  n_municipalities = c(
    dplyr::n_distinct(icc_binary_data$municipality),
    dplyr::n_distinct(icc_ordinal_data$municipality)
  ),
  municipality_variance = c(
    binary_municipality_variance,
    ordinal_municipality_variance
  ),
  residual_variance = pi^2 / 3,
  icc = municipality_variance / (municipality_variance + residual_variance)
)


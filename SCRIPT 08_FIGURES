# Helper function for creating summary data

summarise_by_climate_worry <- function(data, variable) {
  
  data %>%
    mutate(
      climate_worry_group = factor(
        climate_worry,
        levels = c(1, 2, 3, 4),
        labels = c(
          "Not worried",
          "A little worried",
          "Quite worried",
          "Very worried"
        )
      )
    ) %>%
    filter(
      !is.na(climate_worry_group),
      !is.na({{ variable }})
    ) %>%
    group_by(
      climate_worry_group
    ) %>%
    summarise(
      n = n(),
      mean = mean({{ variable }}, na.rm = TRUE),
      sd = sd({{ variable }}, na.rm = TRUE),
      se = sd / sqrt(n),
      lower_ci = mean - 1.96 * se,
      upper_ci = mean + 1.96 * se,
      .groups = "drop"
    )
}

# Create summary data for depressive symptoms

depression_figure_data <- summarise_by_climate_worry(
  depressed_sample,
  depression_mean_0
)

# Create depressive symptoms figure

plot_depression_figure <- ggplot(
  depression_figure_data,
  aes(
    x = climate_worry_group,
    y = mean,
    group = 1
  )
) +
  geom_line(
    linewidth = 0.9,
    color = "#2C3E50"
  ) +
  geom_point(
    aes(fill = climate_worry_group),
    shape = 21,
    size = 3.3,
    color = "black",
    stroke = 0.4
  ) +
  geom_errorbar(
    aes(
      ymin = lower_ci,
      ymax = upper_ci
    ),
    width = 0.10,
    linewidth = 0.55,
    color = "#2C3E50"
  ) +
  scale_fill_manual(
    values = climate_worry_colours

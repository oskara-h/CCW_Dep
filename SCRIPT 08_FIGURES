library(tidyverse)

######################################################
### FIGURE 1: CLIMATE WORRY DISTRIBUTION BY GENDER ###
######################################################

plot_data_gender <- depressed_sample %>%
  dplyr::filter(
    !is.na(climate_worry_0),
    !is.na(gender_binary)
  ) %>%
  dplyr::mutate(
    climate_worry = factor(
      climate_worry_0,
      levels = c(0, 1, 2, 3),
      labels = c(
        "Not at all worried",
        "A little worried",
        "Quite worried",
        "Very worried"
      )
    ),

    gender = factor(
      gender_binary,
      levels = c(0, 1),
      labels = c(
        "Boys",
        "Girls"
      )
    )
  ) %>%
  dplyr::count(
    climate_worry,
    gender,
    name = "n"
  ) %>%
  dplyr::group_by(
    gender
  ) %>%
  dplyr::mutate(
    percent = n / sum(n) * 100
  ) %>%
  dplyr::ungroup()

climate_worry_gender_plot <- ggplot(
  plot_data_gender,
  aes(
    x = climate_worry,
    y = percent,
    fill = gender
  )
) +
  geom_col(
    position = position_dodge(width = 0.90),
    width = 0.90,
    colour = "black",
    linewidth = 0.25
  ) +
scale_fill_manual(
  values = c(
    "Boys"  = "#4F6D8A",
    "Girls" = "#B45A5A"
  )
) +
  scale_y_continuous(
    labels = function(x) paste0(x, "%"),
    expand = expansion(mult = c(0, 0.05))
  ) +
  labs(
    x = "Climate change worry",
    y = "Percentage",
    fill = NULL
  ) +
  theme_classic(
    base_family = "Times New Roman",
    base_size = 22
  ) +
  theme(
    axis.title = element_text(size = 22),
    axis.text = element_text(size = 22),
    legend.position = "top",
    legend.text = element_text(size = 22),
    plot.title = element_blank()
  )

climate_worry_gender_plot



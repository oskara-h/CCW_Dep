# HELPER FUNCTIONS

extract_ordinal_ipw_estimates <- function(model, data, cluster_variable = "municipality") {
  
  model_rows <- as.integer(rownames(stats::model.frame(model)))
  cluster_id <- as.factor(data[[cluster_variable]][model_rows])
  
  clustered_vcov <- sandwich::vcovCL(
    x = model,
    cluster = cluster_id,
    type = "HC1"
  )
  
  slope_terms <- names(stats::coef(model))
  
  tibble::tibble(
    term = slope_terms,
    estimate = unname(stats::coef(model)[slope_terms]),
    variance = unname(diag(clustered_vcov)[slope_terms])
  )
}

extract_binary_ipw_estimates <- function(model, data, cluster_variable = "municipality") {
  
  model_rows <- as.integer(rownames(stats::model.frame(model)))
  cluster_id <- as.factor(data[[cluster_variable]][model_rows])
  
  clustered_vcov <- sandwich::vcovCL(
    x = model,
    cluster = cluster_id,
    type = "HC1"
  )
  
  model_terms <- names(stats::coef(model))
  
  tibble::tibble(
    term = model_terms,
    estimate = unname(stats::coef(model)[model_terms]),
    variance = unname(diag(clustered_vcov)[model_terms])
  )
}

pool_mi_estimates <- function(estimates_list) {
  
  model_terms <- estimates_list[[1]]$term
  
  purrr::map_dfr(
    model_terms,
    function(current_term) {
      
      term_data <- purrr::map_dfr(
        estimates_list,
        ~ dplyr::filter(.x, term == current_term)
      )
      
      pooled_term <- mice::pool.scalar(
        Q = term_data$estimate,
        U = term_data$variance,
        n = Inf
      )
      
      pooled_estimate <- pooled_term$qbar
      pooled_se <- sqrt(pooled_term$t)
      pooled_df <- pooled_term$df
      pooled_statistic <- pooled_estimate / pooled_se
      
      tibble::tibble(
        term = current_term,
        estimate = pooled_estimate,
        std.error = pooled_se,
        df = pooled_df,
        statistic = pooled_statistic,
        p.value = 2 * stats::pt(
          q = abs(pooled_statistic),
          df = pooled_df,
          lower.tail = FALSE
        ),
        conf.low = pooled_estimate -
          stats::qt(.975, df = pooled_df) * pooled_se,
        conf.high = pooled_estimate +
          stats::qt(.975, df = pooled_df) * pooled_se
      )
    }
  )
}

# IPW ORDINAL MODEL

ipw_ordinal_models <- purrr::map(
  ipw_ordinal_list,
  ~ MASS::polr(
    factor(climate_ordinal, ordered = TRUE) ~
      depression_centered *
      antisocial_centered +
      gender_binary +
      age +
      ses +
      university_plans_binary +
      cannabis_binary +
      family_conflict_0 +
      school_dissatisfaction_mean_0 +
      bullying_mean_0 +
      no_close_peer_relationship_binary +
      club_membership_binary +
      social_media_time_0 +
      social_media_pressure_0 +
      reading_time_0 +
      urbanicity_0 +
      family_violence_binary,
    data = .x,
    weights = ipw_missing_truncated,
    Hess = TRUE,
    model = TRUE
  )
)

ipw_ordinal_estimates <- purrr::map2(
  ipw_ordinal_models,
  ipw_ordinal_list,
  extract_ordinal_ipw_estimates
)

ipw_ordinal_results <- pool_mi_estimates(
  ipw_ordinal_estimates
)

print(ipw_ordinal_results, n = Inf)


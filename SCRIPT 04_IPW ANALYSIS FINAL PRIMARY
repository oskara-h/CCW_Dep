# CREATE IPW IMPUTATION DATASET
 ## Separate imputation required to retain participants with missing CW data for the IPW response model

ipw_imputation_data <- depressed_sample %>%
  mutate(
    row_id = row_number(),
    climate_response_observed = if_else(!is.na(climate_binary), 1, 0)
  ) %>%
  dplyr::select(
    row_id,
    climate_response_observed,
    climate_binary,
    climate_ordinal,
    gender_binary,
    age,
    ses,
    university_plans_binary,
    depression_centered,
    antisocial_centered,
    cannabis_binary,
    family_conflict_0,
    school_dissatisfaction_mean_0,
    bullying_mean_0,
    no_close_peer_relationship_binary,
    club_membership_binary,
    social_media_time_0,
    social_media_pressure_0,
    reading_time_0,
    urbanicity_0,
    municipality,
    family_violence_binary
  ) %>%
  mutate(
    across(
      where(~ inherits(.x, "haven_labelled")),
      haven::zap_labels
    )
  )

mice::md.pattern(ipw_imputation_data)

# MULTIPLE IMPUTATION FOR IPW

init_ipw <- mice(
  ipw_imputation_data,
  maxit = 0
)

predictor_matrix_ipw <- init_ipw$predictorMatrix
imp_method_ipw <- init_ipw$method

imp_method_ipw["row_id"] <- ""
imp_method_ipw["climate_response_observed"] <- ""
imp_method_ipw["climate_binary"] <- ""
imp_method_ipw["climate_ordinal"] <- ""
imp_method_ipw["depression_centered"] <- ""

predictor_matrix_ipw[, c("row_id", "climate_binary", "climate_ordinal")] <- 0
predictor_matrix_ipw[c("row_id", "climate_response_observed", "climate_binary", "climate_ordinal"), ] <- 0

set.seed(12345)

Imp_ipw <- mice(
  ipw_imputation_data,
  m = 10,
  maxit = 5,
  method = imp_method_ipw,
  predictorMatrix = predictor_matrix_ipw
)

ipw_completed_all <- mice::complete(
  Imp_ipw,
  action = "all"
)

# ESTIMATE INVERSE PROBABILITY WEIGHTS

estimate_ipw <- function(data) {
  
  response_model <- glm(
    climate_response_observed ~
      gender_binary +
      age +
      ses +
      university_plans_binary +
      depression_centered +
      antisocial_centered +
      cannabis_binary +
      family_conflict_0 +
      school_dissatisfaction_mean_0 +
      bullying_mean_0 +
      no_close_peer_relationship_binary +
      club_membership_binary +
      social_media_time_0 +
      social_media_pressure_0 +
      reading_time_0 +
      urbanicity_0 +
      family_violence_binary,
    data = data,
    family = binomial(link = "logit")
  )
  
  data %>%
    mutate(
      p_observed = predict(response_model, type = "response"),
      ipw_missing = mean(climate_response_observed, na.rm = TRUE) / p_observed,
      ipw_missing_truncated = pmin(
        pmax(
          ipw_missing,
          quantile(ipw_missing, probs = .01, na.rm = TRUE)
        ),
        quantile(ipw_missing, probs = .99, na.rm = TRUE)
      )
    )
}

ipw_completed_all <- purrr::map(
  ipw_completed_all,
  estimate_ipw
)


    formula = ordinal_formula,
    data = .x,
    Hess = TRUE,
    model = TRUE
  )
)

# Extract coefficients and municipality-clustered variances
extract_ordinal_estimates <- function(model, data, cluster_variable = "municipality") {
  
  model_rows <- as.integer(rownames(stats::model.frame(model)))
  
  cluster_id <- data[[cluster_variable]][model_rows]
  cluster_id <- as.factor(cluster_id)
  
  clustered_vcov <- sandwich::vcovCL(
    x = model,
    cluster = cluster_id,
    type = "HC1"
  )
  
  slope_terms <- names(stats::coef(model))
  
  tibble::tibble(
    term = slope_terms,
    estimate = unname(stats::coef(model)[slope_terms]),
    variance = unname(diag(clustered_vcov)[slope_terms])
  )
}

ordinal_estimates <- purrr::map2(
  ordinal_model_list,
  ordinal_completed_data,
  extract_ordinal_estimates
)

# Pool coefficients and variances across imputed datasets using Rubin's rules
pool_mi_estimates <- function(estimates_list) {
  
  model_terms <- estimates_list[[1]]$term
  
  purrr::map_dfr(
    model_terms,
    function(current_term) {
      
      term_data <- purrr::map_dfr(
        estimates_list,
        ~ dplyr::filter(.x, term == current_term)
      )
      
      pooled_term <- mice::pool.scalar(
        Q = term_data$estimate,
        U = term_data$variance,
        n = Inf
      )
      
      pooled_estimate <- pooled_term$qbar
      pooled_se <- sqrt(pooled_term$t)
      pooled_df <- pooled_term$df
      pooled_statistic <- pooled_estimate / pooled_se
      
      tibble::tibble(
        term = current_term,
        estimate = pooled_estimate,
        std.error = pooled_se,
        df = pooled_df,
        statistic = pooled_statistic,
        p.value = 2 * stats::pt(
          q = abs(pooled_statistic),
          df = pooled_df,
          lower.tail = FALSE
        ),
        conf.low = pooled_estimate -
          stats::qt(.975, df = pooled_df) * pooled_se,
        conf.high = pooled_estimate +
          stats::qt(.975, df = pooled_df) * pooled_se
      )
    }
  )
}

standard_ordinal_results <- pool_mi_estimates(
  ordinal_estimates
)

print(

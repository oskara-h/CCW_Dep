  dplyr::select(gender_group, term_label, OR_CI, p) %>%
  pivot_wider(
    names_from = gender_group,
    values_from = c(OR_CI, p),
    names_glue = "{gender_group}_{.value}"
  ) %>%
  dplyr::select(term_label, Boys_OR_CI, Boys_p, Girls_OR_CI, Girls_p) %>%
  gt() %>%
  tab_header(
    title = "Gender-stratified binary models predicting climate disengagement"
  ) %>%
  cols_label(
    term_label = "Predictor",
    Boys_OR_CI = "OR (95% CI)",
    Boys_p = "p",
    Girls_OR_CI = "OR (95% CI)",
    Girls_p = "p"
  ) %>%
  tab_spanner(
    label = "Boys",
    columns = c(Boys_OR_CI, Boys_p)
  ) %>%
  tab_spanner(
    label = "Girls",
    columns = c(Girls_OR_CI, Girls_p)
  ) %>%
  tab_source_note(
    source_note = "Note. OR = odds ratio; CI = confidence interval. * p < .05, ** p < .01, *** p < .001. The outcome is climate disengagement, coded 1 = no climate worry and 0 = any climate worry. Standard errors are clustered by municipality. Results are pooled across multiply imputed datasets using Rubin's rules."
  ) %>%
  tab_options(
    table.font.names = "Times New Roman",
    table.font.size = 12,
    heading.title.font.size = 13,
    column_labels.font.weight = "bold"
  )

binary_stratified_gt

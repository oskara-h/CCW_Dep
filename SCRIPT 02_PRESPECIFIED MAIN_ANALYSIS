)

print(ordinal_cluster_summary)

# Model formula
ordinal_formula <- factor(climate_ordinal, ordered = TRUE) ~
  depression_centered *
  antisocial_centered +
  gender_binary +
  age +
  ses +
  university_plans_binary +
  cannabis_binary +

#######################################
### PARTIAL PROPORTIONAL ODDS MODEL ###
#######################################
if (!exists("ordinal_completed_data")) {
  ordinal_completed_data <- mice::complete(
    Imp_ordinal,
    action = "all"
  )
}

partial_ordinal_models <- ordinal_completed_data %>%
  purrr::map(
    ~ .x %>%
      mutate(
        climate_ordinal_f = factor(
          climate_ordinal,
          levels = c(0, 1, 2),
          labels = c(
            "A little worried",
            "Quite worried",
            "Very worried"
          ),
          ordered = TRUE
        )
      ) %>%
      ordinal::clm(
        climate_ordinal_f ~
          depression_centered *
          antisocial_centered +
          gender_binary +
          age +
          ses +
          university_plans_binary +
          cannabis_binary +
          family_conflict_0 +
          school_dissatisfaction_mean_0 +
          bullying_mean_0 +
          no_close_peer_relationship_binary +
          club_membership_binary +
          social_media_time_0 +
          social_media_pressure_0 +
          reading_time_0 +
          urbanicity_0 +
          family_violence_binary,
        
        nominal = ~
          depression_centered +
          club_membership_binary +
          reading_time_0,
        
        data = .,
        link = "logit",
        Hess = TRUE,
        model = TRUE
      )
  )

partial_ordinal_results <- partial_ordinal_models %>%
  purrr::map(
    ~ broom::tidy(.x)
  )

pooled_input <- partial_ordinal_results %>%
  bind_rows(.id = "imputation") %>%
  mutate(
    imputation = as.integer(imputation)
  ) %>%
  filter(
    !is.na(estimate),
    !is.na(std.error)
  )

pooled_results <- pooled_input %>%
  group_by(term, coef.type) %>%
  summarise(
    m = n(),
    pooled_estimate = mean(estimate),
    within_variance = mean(std.error^2),
    between_variance = var(estimate),
    total_variance = within_variance + (1 + 1 / m) * between_variance,
    pooled_se = sqrt(total_variance),
    lower_ci = pooled_estimate - 1.96 * pooled_se,
    upper_ci = pooled_estimate + 1.96 * pooled_se,
    z_value = pooled_estimate / pooled_se,
    p_value = 2 * pnorm(-abs(z_value)),
    .groups = "drop"
  )

pooled_results_or <- pooled_results %>%
  mutate(
    is_threshold_specific = str_detect(term, "\\."),
    is_pure_threshold = coef.type == "intercept" &
      str_detect(term, "\\(Intercept\\)"),
    
    display_estimate = case_when(
      is_threshold_specific & !is_pure_threshold ~ -pooled_estimate,
      TRUE ~ pooled_estimate
    ),
    display_lower_ci = case_when(
      is_threshold_specific & !is_pure_threshold ~ -upper_ci,
      TRUE ~ lower_ci
    ),
    display_upper_ci = case_when(
      is_threshold_specific & !is_pure_threshold ~ -lower_ci,
      TRUE ~ upper_ci
    ),
    
    odds_ratio = exp(display_estimate),
    or_lower_ci = exp(display_lower_ci),
    or_upper_ci = exp(display_upper_ci)
  ) %>%
  filter(
    !is_pure_threshold
  )


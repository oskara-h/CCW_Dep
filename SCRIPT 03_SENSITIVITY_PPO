      term == "A little worried|Quite worried.reading_time_0" ~ 20,
      term == "Quite worried|Very worried.reading_time_0" ~ 21,
      
      TRUE ~ 99
    )
  ) %>%
  arrange(order) %>%
  dplyr::select(
    domain,
    term_label,
    effect_type,
    OR_CI,
    p
  ) %>%
  mutate(
    across(
      where(is.character),
      ~ iconv(.x, from = "", to = "UTF-8", sub = "")
    )
  )


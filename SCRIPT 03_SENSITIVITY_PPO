      term == "school_dissatisfaction_mean_0" ~ 14,
      term == "no_close_peer_relationship_binary" ~ 15,
      term == "A little worried|Quite worried.club_membership_binary" ~ 16,
      term == "Quite worried|Very worried.club_membership_binary" ~ 17,
      

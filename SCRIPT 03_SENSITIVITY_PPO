#####################################################
### BRANT TEST IN EACH IMPUTED DATASET ##############
#####################################################
run_brant_one_imputation <- function(i) {
  
  completed_data <- ordinal_completed_data[[i]]
  
  model_i <- MASS::polr(
    formula = ordinal_formula,
    data = completed_data,
    Hess = TRUE,
    model = TRUE
  )
  
  brant_i <- brant::brant(
    model_i
  )
  
  brant_table_i <- as.data.frame(
    brant_i
  ) %>%
    tibble::rownames_to_column("term") %>%
    tibble::as_tibble() %>%
    mutate(
      imputation = i
    ) %>%
    dplyr::select(
      imputation,
      term,
      everything()
    )
  
  return(brant_table_i)
}

brant_results_all <- purrr::map_dfr(
  seq_along(ordinal_completed_data),
  run_brant_one_imputation
)

print(
  brant_results_all,
  n = Inf
)

###############################
### SUMMARISE BRANT RESULTS ###
###############################
brant_results_all_clean <- brant_results_all %>%
  rename(
    chi_square = X2,
    p_value = probability
  ) %>%
  mutate(
    significant_05 = p_value < .05,
    significant_01 = p_value < .01
  )

brant_summary <- brant_results_all_clean %>%
  group_by(term) %>%
  summarise(
    n_imputations = n(),
    n_p_below_05 = sum(significant_05, na.rm = TRUE),
    n_p_below_01 = sum(significant_01, na.rm = TRUE),
    median_chi_square = median(chi_square, na.rm = TRUE),
    median_p = median(p_value, na.rm = TRUE),
    min_p = min(p_value, na.rm = TRUE),
    max_p = max(p_value, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(
    median_p
  )

print(
  brant_summary,
  n = Inf
)

# IDENTIFY LIKELY PPO VIOLATIONS

brant_likely_violations <- brant_summary %>%

#####################################################
### CREATE DEPRESSION SCALE USING ORIGINAL CODING ###
#####################################################

ungdata_2022_analytic_fullsamp <- ungdata_2022_analytic_fullsamp %>%
  mutate(
    depression_n = rowSums(
      !is.na(dplyr::select(., depression1:depression6))
    ),
    
    depression_mean_original = ifelse(
      depression_n >= 5,
      rowMeans(
        dplyr::select(., depression1:depression6),
        na.rm = TRUE
      ),
      NA_real_
    )
  )

summary(ungdata_2022_analytic_fullsamp$depression_mean_original)

table(
  ungdata_2022_analytic_fullsamp$depression_n,
  useNA = "ifany"
)


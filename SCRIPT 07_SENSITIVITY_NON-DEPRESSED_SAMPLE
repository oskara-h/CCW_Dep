      climate_worry == 1 ~ 0,
      climate_worry %in% c(2, 3, 4) ~ 1,
      TRUE ~ NA_real_
    ),
    
    climate_ordinal = case_when(
      climate_worry == 2 ~ 0,
      climate_worry == 3 ~ 1,
      climate_worry == 4 ~ 2,
      TRUE ~ NA_real_
    )
  )


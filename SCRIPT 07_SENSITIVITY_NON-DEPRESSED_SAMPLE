pool_mi_estimates_nondep <- function(estimates_list) {
  
  model_terms <- estimates_list[[1]]$term
  
  purrr::map_dfr(
    model_terms,
    function(current_term) {
      
      term_data <- purrr::map_dfr(
        estimates_list,
        ~ dplyr::filter(.x, term == current_term)
      )
      
      pooled_term <- mice::pool.scalar(
        Q = term_data$estimate,
        U = term_data$variance,
        n = Inf
      )
      
      pooled_estimate <- pooled_term$qbar
      pooled_se <- sqrt(pooled_term$t)
      pooled_df <- pooled_term$df
      pooled_statistic <- pooled_estimate / pooled_se
      
      tibble::tibble(
        term = current_term,
        estimate = pooled_estimate,
        std.error = pooled_se,
        df = pooled_df,
        statistic = pooled_statistic,
        p.value = 2 * stats::pt(
          q = abs(pooled_statistic),
          df = pooled_df,
          lower.tail = FALSE
        ),
        conf.low = pooled_estimate -
          stats::qt(.975, df = pooled_df) * pooled_se,
        conf.high = pooled_estimate +
          stats::qt(.975, df = pooled_df) * pooled_se
      )
    }
  )
}

extract_ordinal_estimates_nondep <- function(model, data, cluster_variable = "municipality") {
  
  model_rows <- as.integer(rownames(stats::model.frame(model)))
  cluster_id <- as.factor(data[[cluster_variable]][model_rows])
  
  clustered_vcov <- sandwich::vcovCL(
    x = model,
    cluster = cluster_id,
    type = "HC1"
  )
  
  slope_terms <- names(stats::coef(model))
  
  tibble::tibble(
    term = slope_terms,
    estimate = unname(stats::coef(model)[slope_terms]),
    variance = unname(diag(clustered_vcov)[slope_terms])
  )
}

extract_binary_estimates_nondep <- function(model, data, cluster_variable = "municipality") {
  
  model_rows <- as.integer(rownames(stats::model.frame(model)))
  cluster_id <- as.factor(data[[cluster_variable]][model_rows])
  
  clustered_vcov <- sandwich::vcovCL(
    x = model,
    cluster = cluster_id,
    type = "HC1"
  )
  
  model_terms <- names(stats::coef(model))
  
  tibble::tibble(
    term = model_terms,
    estimate = unname(stats::coef(model)[model_terms]),
    variance = unname(diag(clustered_vcov)[model_terms])
  )
}

label_terms_nondep <- function(data) {
  data %>%
    mutate(
      term_label = case_when(
        term == "(Intercept)" ~ "Intercept",
        term == "depression_centered" ~ "Depressive symptoms",
        term == "antisocial_centered" ~ "Antisocial traits",
        term == "depression_centered:antisocial_centered" ~
          "Depressive symptoms x antisocial traits",
        term == "gender_binary" ~ "Gender (girls)",
        term == "age" ~ "Age",
        term == "ses" ~ "Socioeconomic status",
        term == "university_plans_binary" ~ "University plans",
        term == "cannabis_binary" ~ "Cannabis use",
        term == "family_conflict_0" ~ "Family conflict",
        term == "family_violence_binary" ~ "Family violence",
        term == "bullying_mean_0" ~ "Bullying",
        term == "school_dissatisfaction_mean_0" ~ "School dissatisfaction",
        term == "no_close_peer_relationship_binary" ~ "No close peer relationship",
        term == "club_membership_binary" ~ "Club membership",
        term == "social_media_time_0" ~ "Social media time",
        term == "social_media_pressure_0" ~ "Social media pressure",
        term == "reading_time_0" ~ "Reading time",
        term == "urbanicity_0" ~ "Urbanicity",
        TRUE ~ term
      )
    )
}

format_or_results_nondep <- function(data) {
  data %>%
    mutate(
      odds_ratio = exp(estimate),
      or_lower_ci = exp(conf.low),
      or_upper_ci = exp(conf.high),
      OR_CI = paste0(
        sprintf("%.2f", odds_ratio),
        " (",
        sprintf("%.2f", or_lower_ci),
        ", ",
        sprintf("%.2f", or_upper_ci),
        ")"
      ),
      significance = case_when(
        p.value < .001 ~ "***",
        p.value < .01 ~ "**",
        p.value < .05 ~ "*",
        TRUE ~ ""
      ),
      p = case_when(
        p.value < .001 ~ paste0("< .001", significance),
        TRUE ~ paste0(sprintf("%.3f", p.value), significance)
      )
    )
}


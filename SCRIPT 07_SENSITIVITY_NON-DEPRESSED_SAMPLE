################################################
### MUNICIPALITY CLUSTERING: NULL ICC MODELS ###
################################################

icc_binary_data_fullsamp <- full_sample_fullsamp %>%
  filter(
    !is.na(climate_binary),
    !is.na(municipality)
  ) %>%
  mutate(
    climate_disengagement = 1 - climate_binary,
    municipality = factor(municipality)
  )

icc_ordinal_data_fullsamp <- full_sample_fullsamp %>%
  filter(
    !is.na(climate_ordinal),
    !is.na(municipality)
  ) %>%
  mutate(
    climate_ordinal = factor(
      climate_ordinal,
      ordered = TRUE
    ),
    municipality = factor(municipality)
  )

icc_binary_model_fullsamp <- lme4::glmer(
  climate_disengagement ~ 1 + (1 | municipality),
  data = icc_binary_data_fullsamp,
  family = binomial(link = "logit"),
  control = glmerControl(
    optimizer = "bobyqa",
    optCtrl = list(maxfun = 100000)
  )
)

icc_ordinal_model_fullsamp <- ordinal::clmm(
  climate_ordinal ~ 1 + (1 | municipality),
  data = icc_ordinal_data_fullsamp,
  link = "logit",
  Hess = TRUE
)

binary_municipality_variance_fullsamp <- as.data.frame(
  lme4::VarCorr(icc_binary_model_fullsamp)
)$vcov[1]

ordinal_municipality_variance_fullsamp <- as.numeric(
  ordinal::VarCorr(icc_ordinal_model_fullsamp)$municipality
)

icc_summary_fullsamp <- tibble::tibble(
  outcome = c(
    "Climate disengagement",
    "Climate worry severity among worried adolescents"
  ),
  model = c(
    "Binary logistic null model",
    "Ordinal logistic null model"
  ),
  n_observations = c(
    nrow(icc_binary_data_fullsamp),
    nrow(icc_ordinal_data_fullsamp)
  ),
  n_municipalities = c(
    dplyr::n_distinct(icc_binary_data_fullsamp$municipality),
    dplyr::n_distinct(icc_ordinal_data_fullsamp$municipality)
  ),
  municipality_variance = c(
    binary_municipality_variance_fullsamp,
    ordinal_municipality_variance_fullsamp
  ),
  residual_variance = pi^2 / 3,
  icc = municipality_variance / (municipality_variance + residual_variance)
)

icc_summary_fullsamp

